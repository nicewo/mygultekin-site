rules_version = '2';

// Panel erişimi: sadece admins/{uid} belgesi olan Google hesapları.
// Admin belgesi koddan YAZILAMAZ; Firebase konsolundan elle eklenir.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Kullanıcı sadece kendi admin kaydının var olup olmadığını okuyabilir.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Panel kartları: her kart bir uygulamaya/servise kısayol.
    // Şifre veya anahtar SAKLANMAZ; sadece başlık, adres ve kopyalanacak komut.
    function validApp(d) {
      return d.keys().hasAll(['title', 'desc', 'url', 'command', 'tag', 'order', 'updatedAt'])
        && d.keys().hasOnly(['title', 'desc', 'url', 'command', 'tag', 'order', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.desc is string && d.desc.size() <= 300
        && d.url is string && d.url.size() <= 500
        && (d.url == '' || d.url.matches('^(https?|ssh)://[^\\s]+$'))
        && d.command is string && d.command.size() <= 300
        && d.tag is string && d.tag.size() <= 30
        && d.order is int && d.order >= 0 && d.order < 1000
        && d.updatedAt == request.time;
    }

    match /apps/{appId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validApp(request.resource.data);
    }

    // Geri kalan her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
